# ---- Site addresses (Caddy syntax) --------------------------------------
# With real domains Caddy issues TLS automatically:
#   WEB_DOMAIN=daemun.example.com
#   ADMIN_DOMAIN=admin.daemun.example.com
#   API_DOMAIN=api.daemun.example.com
# Before DNS is set up, run on the bare IP over plain HTTP:
#   WEB_DOMAIN=http://104.36.69.86
#   ADMIN_DOMAIN=http://104.36.69.86:8081
#   API_DOMAIN=http://104.36.69.86:8080
WEB_DOMAIN=daemun.example.com
ADMIN_DOMAIN=admin.daemun.example.com
API_DOMAIN=api.daemun.example.com
# Full origin (with scheme) the admin panel is served from — must match ADMIN_DOMAIN
# (better-auth baseURL + trustedOrigins; a mismatch breaks login with 403).
ADMIN_URL=https://admin.daemun.example.com
# Full origin (with scheme) of the public site — must match WEB_DOMAIN.
# Used for CSRF trustedOrigins and for links in sign-up / password-reset emails.
WEB_PUBLIC_URL=https://daemun.example.com

# ---- Postgres ----------------------------------------------------------
POSTGRES_DB=daemun
POSTGRES_USER=daemun
POSTGRES_PASSWORD=change-me

# ---- API ---------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# shared between api and web for the cache-invalidation webhook
REVALIDATE_SECRET=change-me

# First admin account, created once when the user table is empty
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Administrator

# ---- Outgoing mail (delegate sign-up verification, password reset) ------
# Leave SMTP_HOST empty to print the links to the API log instead of sending.
# Gmail: enable 2-step verification, create an App Password, then
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DAEMUN III <no-reply@daemun.example.com>
