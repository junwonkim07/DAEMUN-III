# Reference for the HOSTED environment (Vercel project variables). Local
# development needs only apps/api/.env with ADMIN_EMAIL, ADMIN_PASSWORD (the
# first admin — created by bootstrap() on local boot only) and
# REVALIDATE_SECRET (handover.md §2); everything else falls back to localhost
# defaults and docker-compose.dev.yml provides Postgres.

# ---- Origins (daemun-api) ------------------------------------------------
# Full origin (with scheme) the admin panel is served from
# (better-auth baseURL + trustedOrigins; a mismatch breaks login with 403).
ADMIN_URL=https://daemun-admin.vercel.app
# Full origin (with scheme) of the public site. Used for CSRF trustedOrigins
# and for the links in sign-up / password-reset emails.
WEB_PUBLIC_URL=https://daemun-web.vercel.app
# Where the API reaches the site for the revalidate webhook — on the hosted
# stack the same public origin as above.
WEB_URL=https://daemun-web.vercel.app

# ---- Postgres (daemun-api) -------------------------------------------------
# A managed Postgres that sleeps when idle: use the *pooled* endpoint at
# runtime and keep the per-instance pool small — each serverless instance
# opens its own.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=verify-full
DB_POOL_MAX=5
# Required on daemun-api: the production build (apps/api/scripts/vercel-build.mjs)
# refuses to run without it. Must be the *direct* endpoint — DDL through a
# transaction-mode pooler is not something to rely on. Only a manual
# `pnpm db:migrate` falls back to DATABASE_URL.
MIGRATE_DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=verify-full

# ---- Uploads -----------------------------------------------------------
# Hosted (Vercel) must use "blob": files go to Vercel Blob and the SDK reads
# BLOB_READ_WRITE_TOKEN from the environment on its own. "local" is the
# local-dev / self-host default only — it keeps files under UPLOAD_DIR on a
# single long-lived process's disk, which on Vercel is ephemeral (uploads
# would silently vanish).
UPLOAD_DRIVER=blob
BLOB_READ_WRITE_TOKEN=
# MAX_UPLOAD_MB=25

# ---- Frontends (build-time) --------------------------------------------
# Where apps/web and apps/admin reach the API. Baked into next.config.ts
# rewrites when the frontend is BUILT, not read at runtime — set it as a
# project variable on daemun-web and daemun-admin. A production build without
# it fails on purpose.
# API_URL=https://api.daemun.example.com

# ---- API ---------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# shared between api and web for the cache-invalidation webhook
REVALIDATE_SECRET=change-me

# First admin account, created once when the user table is empty
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Administrator

# ---- 안내 챗봇 (POST /api/chat) --------------------------------------
# Google AI Studio 무료 키: https://aistudio.google.com/apikey
# 무료 티어 Flash-Lite ~15 RPM / ~1,000 req/day — 동아리 트래픽엔 충분.
# 비워두면 챗봇 위젯은 뜨지만 "설정되지 않았어요" 안내만 나온다.
# 주의: 무료 티어는 입력이 Google 제품 개선에 쓰일 수 있음 (방문자 질문 포함).
GEMINI_API_KEY=
# 기본값 gemini-2.5-flash. 다른 모델은 ListModels(GET /v1beta/models)로 실제 id
# 확인 후 넣는다 (예: gemini-flash-lite-latest — 더 저렴/빠르지만 가용성이 덜 안정적).
# GEMINI_MODEL=

# ---- Outgoing mail (delegate sign-up verification, password reset) ------
# Leave SMTP_HOST empty to print the links to the API log instead of sending.
# Gmail: enable 2-step verification, create an App Password, then
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DAEMUN III <no-reply@daemun.example.com>
