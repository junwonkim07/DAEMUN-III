{$WEB_DOMAIN} {
	encode zstd gzip
	# uploaded files live on the API server; expose them under the public site too
	handle /uploads/* {
		reverse_proxy api:4000
	}
	# 안내 챗봇 — zod 검증 전에 거대한 본문이 버퍼링되지 않도록 (Hono bodyLimit도 있음)
	handle /api/chat {
		request_body {
			max_size 64KB
		}
		reverse_proxy web:3000
	}
	handle {
		reverse_proxy web:3000
	}
}

{$ADMIN_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 30MB
	}
	# admin's own Next.js rewrites forward /api/* and /uploads/* to the API,
	# so everything can go to the admin container.
	reverse_proxy admin:3001
}

{$API_DOMAIN} {
	encode zstd gzip
	# the chatbot takes small JSON only — cap it before the 30MB upload limit applies
	handle /api/public/chat {
		request_body {
			max_size 64KB
		}
		reverse_proxy api:4000
	}
	handle {
		request_body {
			max_size 30MB
		}
		reverse_proxy api:4000
	}
}
